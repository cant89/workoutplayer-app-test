    "pendolamento": {
      "nome": "pendolamento di Codman",
      "nome_esteso": "Pendolamento di Codman",
      "attrezzi": "Tavolo di appoggio",
      "istruzioni": [
        "Si pieghi in avanti appoggiando il braccio sano su un tavolo",
        "Lasci oscillare liberamente il braccio operato",
