      "attrezzi": "Bastone",
      "istruzioni": [
        "Tenga il bastone con entrambe le mani",
        "Usi il braccio sano per guidare il sollevamento del braccio operato",
        "Mantenga il movimento lento e indolore",
        "Si fermi se compare dolore acuto"
      ],
      "fonti": [
        "d1:r20",
        "d1:r21"
      ]
    },
    "retrazione_scapolare": {
      "nome": "retrazione scapolare a corpo libero",
      "nome_esteso": "Retrazione scapolare a corpo libero",
      "attrezzi": "",
      "istruzioni": [
        "Stia in piedi con le braccia rilassate",
        "Avvicini le scapole verso la colonna",
        "Mantenga brevemente la posizione e rilasci",
        "Eviti di sollevare le spalle verso le orecchie"
      ],
      "fonti": [
        "d1:r22",
        "d1:r23"
      ]
    },
    "extrarotazione_elastico": {
      "nome": "extrarotazione con elastico verde",
      "nome_esteso": "Extrarotazione di spalla con elastico",
      "attrezzi": "Elastico verde",
      "istruzioni": [
        "Tenga il gomito fermo lungo il fianco",
        "Afferri l'elastico e ruoti l'avambraccio verso l'esterno",
        "Mantenga la contrazione isometrica per il tempo indicato",
        "Torni lentamente alla posizione di partenza"
      ],
      "fonti": [
        "d1:r27",
        "d1:r28",
        "d1:r29"
      ]
    },
    "sleeper_stretch": {
      "nome": "stretching capsulare posteriore (sleeper stretch)",
      "nome_esteso": "Stretching capsulare posteriore (sleeper stretch)",
      "attrezzi": "",
      "istruzioni": [
        "Si sdrai sul fianco del braccio operato",
        "Con la mano opposta spinga delicatamente l'avambraccio verso il basso",
        "Mantenga uno stiramento leggero, senza dolore",
        "Respiri regolarmente durante la tenuta"
      ],
      "fonti": [
        "d1:r29",
        "d1:r30"
      ]
    },
    "rinforzo_manubrio": {
