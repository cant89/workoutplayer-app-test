      "it": "Panca piana con bilanciere",
      "gear": "panca piana, bilanciere",
      "how": [
        "Sdraiati sulla panca con i piedi ben appoggiati a terra",
        "Abbassa il bilanciere controllato fino al petto",
        "Spingi verso l'alto mantenendo le scapole retratte"
      ]
    },
    "panca_inclinata": {
      "name": "panca inclinata",
      "it": "Panca inclinata con bilanciere",
      "gear": "panca inclinata, bilanciere",
      "how": [
        "Regola la panca con inclinazione moderata",
        "Abbassa il bilanciere verso la parte alta del petto",
        "Spingi in alto senza bloccare di scatto i gomiti"
      ]
    },
    "affondi_cammino": {
      "name": "affondi in cammino",
      "it": "Affondi camminati con manubri",
      "gear": "manubri",
      "how": [
        "Tieni un manubrio per mano lungo i fianchi",
        "Esegui un passo lungo in avanti flettendo entrambe le ginocchia",
        "Spingi sul piede avanti per avanzare al passo successivo"
      ]
    },
    "curl_fitball": {
      "name": "curl su fitball",
      "it": "Curl femorale su fitball",
      "gear": "fitball",
      "how": [
        "Sdraiati supino con i talloni appoggiati sulla fitball",
        "Solleva il bacino da terra",
        "Fletti le ginocchia portando la palla verso i glutei"
      ]
    },
    "plank_laterale": {
      "name": "plank laterale",
      "it": "Plank laterale",
      "gear": "",
      "how": [
        "Appoggiati su avambraccio e bordo del piede, corpo in linea",
        "Mantieni il bacino sollevato senza cedere",
        "Respira in modo regolare durante la tenuta"
      ]
    }
  },
