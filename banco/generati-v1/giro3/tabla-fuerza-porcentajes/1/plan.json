  "esercizi": {
    "sentadilla": {
      "nome": "Sentadilla trasera",
      "nome_esteso": "Sentadilla trasera con barra (back squat)",
      "attrezzi": "Barra olímpica, rack de sentadillas, discos",
      "istruzioni": [
        "Coloca la barra sobre los trapecios, pies a la anchura de los hombros",
        "Desciende flexionando cadera y rodillas manteniendo la espalda neutra",
        "Baja hasta que los muslos queden paralelos al suelo, o según tu movilidad",
        "Sube empujando con los talones hasta la extensión completa"
      ],
      "fonti": [
        "d1:p1:r11",
        "d1:p1:r12"
      ]
    },
    "press_banca": {
      "nome": "Press banca plano",
      "nome_esteso": "Press de banca plano con barra",
      "attrezzi": "Barra, banco plano, discos",
      "istruzioni": [
        "Túmbate en el banco con los pies apoyados en el suelo",
        "Baja la barra de forma controlada hasta el pecho",
        "Empuja la barra hacia arriba hasta extender los brazos",
        "Mantén los omóplatos retraídos durante todo el movimiento"
      ],
      "fonti": [
        "d1:p1:r13",
        "d1:p1:r14"
      ]
    },
    "peso_muerto": {
      "nome": "Peso muerto rumano",
      "nome_esteso": "Peso muerto rumano con barra",
      "attrezzi": "Barra, discos",
      "istruzioni": [
        "Sujeta la barra con agarre prono a la altura de las caderas",
        "Flexiona la cadera hacia atrás manteniendo las rodillas ligeramente flexionadas",
        "Baja la barra pegada a las piernas hasta sentir el estiramiento de isquiotibiales",
        "Vuelve a la posición inicial extendiendo la cadera"
      ],
      "fonti": [
        "d1:p1:r15",
        "d1:p1:r16"
      ]
    },
    "remo": {
      "nome": "Remo con barra",
      "nome_esteso": "Remo con barra inclinado",
      "attrezzi": "Barra, discos",
      "istruzioni": [
        "Inclina el tronco hacia adelante manteniendo la espalda recta",
        "Tira de la barra hacia el abdomen apretando la espalda",
        "Baja la barra de forma controlada hasta la extensión de brazos"
      ],
      "fonti": [
        "d1:p1:r17",
        "d1:p1:r18"
      ]
    }
