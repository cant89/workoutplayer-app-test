    "air_squat": {
      "name": "Air squat",
      "it": "Squat a corpo libero",
      "gear": "",
      "how": [
        "Piedi alla larghezza delle spalle",
        "Scendi controllando il bacino all'indietro",
        "Mantieni il petto alto",
        "Spingi sui talloni per risalire"
      ]
    },
    "mountain_climber": {
      "name": "Mountain climber",
      "it": "Mountain climber",
      "gear": "",
      "how": [
        "Posizione di plank sulle mani",
        "Porta un ginocchio al petto alternando le gambe",
        "Mantieni il bacino stabile",
        "Ritmo controllato e continuo"
      ]
    },
    "push_up": {
      "name": "Push-up",
      "it": "Piegamenti sulle braccia",
      "gear": "",
      "how": [
        "Mani sotto le spalle, corpo in linea",
        "Scendi fino quasi a sfiorare il petto a terra",
        "Spingi per tornare alla posizione di partenza"
      ]
    },
    "sit_up": {
      "name": "Sit-up",
      "it": "Sit-up",
      "gear": "",
      "how": [
        "Sdraiato supino, ginocchia piegate",
        "Sali portando il busto verso le ginocchia",
        "Ridiscendi in modo controllato"
      ]
    },
    "kettlebell_swing": {
      "name": "Kettlebell swing",
      "it": "Swing con kettlebell",
      "gear": "Kettlebell",
      "how": [
        "Piedi alla larghezza delle spalle, kettlebell davanti",
        "Spinta d'anca per far oscillare il kettlebell",
        "Schiena neutra, braccia rilassate durante lo swing"
      ]
    },
    "burpee": {
      "name": "Burpee",
      "it": "Burpee",
      "gear": "",
      "how": [
        "Dalla posizione eretta scendi in plank",
        "Esegui un piegamento o un appoggio a terra",
        "Salta i piedi verso le mani e salta verso l'alto"
      ]
    },
    "recupero": {
      "name": "Recupero fra blocchi",
      "it": "Recupero attivo fra i blocchi",
      "gear": "",
      "how": [
        "Cammina lentamente senza fermarti",
        "Mantieni una respirazione regolare"
      ]
    }
  },
