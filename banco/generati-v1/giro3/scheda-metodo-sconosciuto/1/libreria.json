  "exercises": {
    "squat_frontale": {
      "name": "Squat frontale",
      "it": "Squat frontale con bilanciere",
      "gear": "bilanciere, rack",
      "how": [
        "Posiziona il bilanciere sulla parte anteriore delle spalle",
        "Scendi controllando il core",
        "Risali spingendo sui talloni"
      ]
    },
    "panca_piana": {
      "name": "Panca piana",
      "it": "Panca piana con bilanciere",
      "gear": "bilanciere, panca",
      "how": [
        "Sdraiati sulla panca con presa poco più larga delle spalle",
        "Scendi il bilanciere al petto",
        "Spingi verso l'alto senza staccare i glutei"
      ]
    },
    "trazioni_sbarra": {
      "name": "Trazioni alla sbarra",
      "it": "Trazioni alla sbarra",
      "gear": "sbarra",
      "how": [
        "Presa prona poco più larga delle spalle",
        "Tira fino a portare il mento sopra la sbarra",
        "Scendi controllando il movimento"
      ]
    },
    "stacco_terra": {
      "name": "Stacco da terra",
      "it": "Stacco da terra con bilanciere",
      "gear": "bilanciere",
      "how": [
        "Piedi sotto il bilanciere, schiena neutra",
        "Spingi con le gambe mantenendo il bilanciere vicino al corpo",
        "Estendi anche e ginocchia insieme"
      ]
    },
    "push_press": {
      "name": "Push press",
      "it": "Push press con bilanciere",
      "gear": "bilanciere",
      "how": [
        "Bilanciere sulle clavicole",
        "Usa una leggera flessione di gambe per generare slancio",
        "Spingi il bilanciere sopra la testa"
      ]
    },
    "burpee": {
      "name": "Burpee",
      "it": "Burpee con salto sopra la sbarra",
      "gear": "sbarra",
      "how": [
        "Scendi in piegamento sul pavimento",
        "Risali con un salto",
        "Salta sopra la sbarra (o versione senza salto)"
      ]
    }
  },
