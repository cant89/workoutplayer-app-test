  "exercises": {
    "squat": {
      "name": "squat",
      "it": "Squat con bilanciere",
      "gear": "Bilanciere, rack",
      "how": [
        "Piedi alla larghezza delle spalle",
        "Scendi mantenendo la schiena neutra",
        "Spingi sui talloni per risalire"
      ]
    },
    "panca": {
      "name": "panca",
      "it": "Panca piana con bilanciere",
      "gear": "Bilanciere, panca",
      "how": [
        "Scapole retratte sulla panca",
        "Abbassa il bilanciere al petto controllando",
        "Spingi in alto senza sbattere i gomiti"
      ]
    },
    "rematore_bilanciere": {
      "name": "rematore bilanciere",
      "it": "Rematore con bilanciere",
      "gear": "Bilanciere",
      "how": [
        "Busto inclinato in avanti, schiena neutra",
        "Tira il bilanciere verso l'addome",
        "Controlla la discesa"
      ]
    },
    "stacco": {
      "name": "stacco",
      "it": "Stacco da terra",
      "gear": "Bilanciere",
      "how": [
        "Bilanciere vicino agli stinchi",
        "Spingi con le gambe mantenendo la schiena neutra",
        "Estendi anche e ginocchia insieme"
      ]
    },
    "trazioni": {
      "name": "trazioni",
      "it": "Trazioni alla sbarra",
      "gear": "Sbarra",
      "how": [
        "Presa prona alla larghezza delle spalle",
        "Tira il mento sopra la sbarra",
        "Controlla la discesa"
      ]
    },
    "affondi_bulgari": {
      "name": "affondi bulgari",
      "it": "Affondi bulgari con manubri",
      "gear": "Manubri, panca",
      "how": [
        "Piede posteriore appoggiato su una panca",
        "Scendi in affondo sulla gamba anteriore",
        "Risali spingendo sul tallone"
      ]
    },
    "military_press": {
      "name": "military press",
      "it": "Military press con bilanciere",
      "gear": "Bilanciere",
      "how": [
        "In piedi, bilanciere all'altezza delle spalle",
        "Spingi sopra la testa senza inarcare troppo la schiena",
        "Controlla la discesa"
      ]
    },
    "curl_manubri": {
      "name": "curl manubri",
      "it": "Curl bicipiti con manubri",
      "gear": "Manubri",
      "how": [
        "Gomiti fermi lungo i fianchi",
        "Solleva i manubri flettendo il gomito",
        "Controlla la discesa"
      ]
    },
    "plank": {
      "name": "plank",
      "it": "Plank su avambracci",
      "gear": "",
      "how": [
        "Avambracci a terra, corpo in linea retta",
        "Contrai addome e glutei",
        "Respira mantenendo la posizione"
      ]
    }
