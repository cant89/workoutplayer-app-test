  "esercizi": {
    "panca_piana": {
      "nome": "Panca piana",
      "nome_esteso": "Panca piana con bilanciere",
      "attrezzi": "bilanciere, panca piana",
      "istruzioni": [
        "Sdraiati sulla panca con i piedi ben appoggiati a terra",
        "Abbassa il bilanciere al petto in modo controllato",
        "Spingi verso l'alto senza bloccare di scatto i gomiti"
      ],
      "fonti": [
        "d1:r5"
      ]
    },
    "squat": {
      "nome": "Squat",
      "nome_esteso": "Squat con bilanciere",
      "attrezzi": "bilanciere, rack",
      "istruzioni": [
        "Posiziona il bilanciere sulle spalle",
        "Scendi mantenendo la schiena dritta e le ginocchia in linea con i piedi",
        "Risali spingendo sui talloni"
      ],
      "fonti": [
        "d1:r6"
      ]
    },
    "trazioni": {
      "nome": "Trazioni alla sbarra",
      "nome_esteso": "Trazioni alla sbarra",
      "attrezzi": "sbarra per trazioni",
      "istruzioni": [
        "Impugna la sbarra con presa salda",
        "Tira il corpo verso l'alto fino a portare il mento sopra la sbarra",
        "Scendi in modo controllato"
      ],
      "fonti": [
        "d1:r7"
      ]
    },
    "plank": {
      "nome": "Plank",
      "nome_esteso": "Plank su avambracci",
      "attrezzi": "",
      "istruzioni": [
        "Appoggia gli avambracci a terra e distendi il corpo",
        "Mantieni addome e glutei contratti",
        "Tieni la schiena dritta senza inarcarla"
      ],
      "fonti": [
        "d1:r8"
      ]
    },
    "affondi": {
      "nome": "Affondi con manubri",
      "nome_esteso": "Affondi camminati o in loco con manubri",
      "attrezzi": "manubri",
      "istruzioni": [
        "Tieni un manubrio per mano lungo i fianchi",
        "Fai un passo avanti e scendi flettendo entrambe le ginocchia",
        "Torna alla posizione di partenza e alterna il lato"
      ],
      "fonti": [
        "d1:r9"
      ]
    }
