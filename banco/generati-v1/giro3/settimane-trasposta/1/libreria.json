{
  "id": "settimane-trasposta",
  "api": "v1",
  "title": "SCHEDA MENSILE — 8 SEDUTE (ottobre 2026)",
  "lang": "it-IT",
  "storageKey": "wp-settimane-trasposta",
  "kicker": "SCHEDA MENSILE — 8 SEDUTE (ottobre 2026)",
  "rules": [
    "Schema fisso per esercizio (le celle sotto riportano solo il carico in kg): Squat 4x8 · Affondi 3x10 per lato · Military Press 3x10 · Alzate Laterali 3x12"
  ],
  "exercises": {
    "squat": {
      "name": "Squat",
      "it": "Squat con bilanciere",
      "gear": "Bilanciere, rack",
      "how": [
        "Posiziona il bilanciere sulla parte alta della schiena",
        "Scendi piegando le ginocchia mantenendo la schiena dritta",
        "Risali spingendo sui talloni"
      ]
    },
    "affondi": {
      "name": "Affondi",
      "it": "Affondi con manubri",
      "gear": "Manubri",
      "how": [
        "Fai un passo in avanti con una gamba",
        "Torna alla posizione di partenza e ripeti sull'altro lato"
      ]
    },
    "military_press": {
      "name": "Military Press",
      "it": "Military Press con bilanciere",
      "gear": "Bilanciere",
      "how": [
        "Impugna il bilanciere all'altezza delle spalle",
        "Spingi il bilanciere sopra la testa fino a distendere le braccia",
        "Ritorna lentamente alla posizione di partenza"
      ]
    },
    "alzate_laterali": {
      "name": "Alzate Laterali",
      "it": "Alzate laterali con manubri",
      "gear": "Manubri",
      "how": [
        "Tieni un manubrio per mano lungo i fianchi",
        "Solleva le braccia lateralmente fino all'altezza delle spalle",
        "Abbassa lentamente controllando il movimento"
      ]
    }
  },
