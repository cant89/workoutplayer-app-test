{
  "id": "settimane-emom",
  "api": "v1",
  "title": "MICROCICLO 4 SETTIMANE",
  "lang": "it-IT",
  "storageKey": "wp-settimane-emom",
  "kicker": "Palestra Nova Fitness — rivalutazione carichi ogni 4 settimane",
  "rules": [
    "Rivalutazione carichi ogni 4 settimane"
  ],
  "exercises": {
    "squat_multipower": {
      "name": "Squat al multipower",
      "it": "Squat al multipower",
      "gear": "Multipower (squat guidato)",
      "how": [
        "Posiziona il bilanciere sulle spalle sotto il supporto guidato",
        "Scendi controllando ginocchia e busto",
        "Spingi sui talloni per risalire"
      ]
    },
    "panca_piana_bilanciere": {
      "name": "Panca piana bilanciere",
      "it": "Panca piana con bilanciere",
      "gear": "Panca piana, bilanciere",
      "how": [
        "Sdraiati sulla panca con i piedi ben appoggiati",
        "Scendi il bilanciere al petto controllando il movimento",
        "Spingi verso l'alto senza bloccare di scatto i gomiti"
      ]
    },
    "rematore_bilanciere": {
      "name": "Rematore bilanciere",
      "it": "Rematore con bilanciere",
      "gear": "Bilanciere",
      "how": [
        "Busto inclinato in avanti, schiena neutra",
        "Tira il bilanciere verso l'addome",
        "Controlla la fase di ritorno"
      ]
    },
    "affondi_manubri": {
      "name": "Affondi con manubri",
      "it": "Affondi camminati o in loco con manubri",
      "gear": "Manubri",
      "how": [
        "Fai un passo avanti e scendi flettendo entrambe le ginocchia",
        "Mantieni il busto eretto",
        "Spingi per tornare alla posizione di partenza"
      ]
    },
    "military_press_manubri": {
      "name": "Military Press manubri",
      "it": "Military press con manubri da seduto",
      "gear": "Manubri, panca con schienale",
      "how": [
        "Siediti con schiena appoggiata",
        "Spingi i manubri sopra la testa",
        "Scendi controllando fino all'altezza delle spalle"
      ]
    },
    "plank": {
      "name": "Plank",
      "it": "Plank su avambracci",
      "gear": "",
      "how": [
        "Appoggiati sugli avambracci e sulle punte dei piedi",
        "Mantieni il corpo allineato",
        "Contrai l'addome per tutta la durata"
      ]
    },
    "kettlebell_swing": {
      "name": "Kettlebell swing",
      "it": "Kettlebell swing a due mani",
      "gear": "Kettlebell",
      "how": [
        "Spingi i fianchi indietro per caricare",
        "Estendi i fianchi con forza per portare il kettlebell in avanti",
        "Mantieni la schiena neutra"
      ]
    },
    "stacco_rumeno": {
      "name": "Stacco rumeno bilanciere",
      "it": "Stacco rumeno con bilanciere",
      "gear": "Bilanciere",
      "how": [
        "Mantieni le ginocchia leggermente flesse",
        "Fai scorrere il bilanciere lungo le gambe",
        "Spingi i fianchi in avanti per risalire"
      ]
    },
    "trazioni_assistite": {
      "name": "Trazioni assistite (elastico verde)",
      "it": "Trazioni alla sbarra assistite con elastico",
      "gear": "Sbarra, elastico verde",
      "how": [
        "Posiziona il ginocchio o il piede nell'elastico",
        "Tira il mento sopra la sbarra",
        "Scendi controllando il movimento"
      ]
    },
    "leg_press": {
      "name": "Leg press",
      "it": "Leg press orizzontale/inclinata",
      "gear": "Macchina leg press",
      "how": [
        "Posiziona i piedi larghi sulla pedana",
        "Scendi controllando fino a 90° circa",
        "Spingi senza bloccare le ginocchia"
      ]
    },
    "alzate_laterali_manubri": {
      "name": "Alzate laterali manubri",
      "it": "Alzate laterali con manubri",
      "gear": "Manubri",
      "how": [
        "Solleva i manubri lateralmente fino all'altezza delle spalle",
        "Mantieni un leggero piegamento dei gomiti",
        "Scendi controllando il movimento"
      ]
    },
    "curl_bilanciere_ez": {
      "name": "Curl bilanciere EZ",
      "it": "Curl bicipiti con bilanciere EZ",
      "gear": "Bilanciere EZ",
      "how": [
        "Mantieni i gomiti fermi lungo i fianchi",
        "Solleva il bilanciere contraendo i bicipiti",
        "Scendi controllando il movimento"
      ]
    },
    "burpee": {
      "name": "Burpee",
      "it": "Burpee completo",
      "gear": "",
      "how": [
        "Scendi in accosciata e appoggia le mani",
        "Salta i piedi indietro in plank e torna avanti",
        "Salta con le braccia sopra la testa"
      ]
    },
    "mountain_climber": {
      "name": "Mountain climber",
      "it": "Mountain climber in plank",
      "gear": "",
      "how": [
        "Mantieni la posizione di plank",
        "Porta alternativamente le ginocchia al petto",
        "Mantieni il bacino stabile"
      ]
    },
    "jumping_jack": {
      "name": "Jumping jack",
      "it": "Jumping jack",
      "gear": "",
      "how": [
        "Salta aprendo gambe e braccia contemporaneamente",
        "Torna alla posizione di partenza saltando",
        "Mantieni un ritmo costante"
      ]
    },
    "squat_corpo_libero": {
      "name": "Squat a corpo libero",
      "it": "Squat a corpo libero",
      "gear": "",
      "how": [
        "Scendi flettendo anche e ginocchia",
        "Mantieni il busto eretto",
        "Spingi sui talloni per risalire"
      ]
    },
    "goblet_squat": {
      "name": "Kettlebell goblet squat",
      "it": "Goblet squat con kettlebell",
      "gear": "Kettlebell",
      "how": [
        "Tieni il kettlebell davanti al petto",
        "Scendi mantenendo il tallone a terra",
        "Risali spingendo sui talloni"
      ]
    },
    "push_press_manubri": {
      "name": "Push press manubri",
      "it": "Push press con manubri",
      "gear": "Manubri",
      "how": [
        "Fletti leggermente le ginocchia per caricare",
        "Spingi i manubri sopra la testa con l'aiuto delle gambe",
        "Scendi controllando il movimento"
      ]
    },
    "box_step_up": {
      "name": "Box step-up",
      "it": "Step-up su box",
      "gear": "Box o rialzo",
      "how": [
        "Sali sul box con un piede alla volta",
        "Estendi completamente l'anca in alto",
        "Scendi controllando il movimento"
      ]
    },
    "push_up": {
      "name": "Push-up",
      "it": "Piegamenti sulle braccia",
      "gear": "",
      "how": [
        "Mantieni il corpo allineato",
        "Scendi flettendo i gomiti",
        "Spingi per tornare in posizione"
      ]
    }
  },
