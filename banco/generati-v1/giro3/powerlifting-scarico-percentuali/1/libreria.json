{
  "id": "powerlifting-scarico-percentuali",
  "api": "v1",
  "title": "Mesociclo Forza - 4 Settimane (Powerlifting)",
  "lang": "it-IT",
  "storageKey": "wp-powerlifting-scarico-percentuali",
  "rules": [
    "Massimali di riferimento: Squat 150 kg, Panca 100 kg, Stacco 180 kg",
    "Nota: le percentuali sono sul massimale di riferimento indicato sopra, non su un test recente."
  ],
  "exercises": {
    "squat": {
      "name": "Squat",
      "it": "Squat con bilanciere",
      "gear": "Bilanciere, rack, dischi",
      "how": [
        "Posiziona il bilanciere sulla parte alta della schiena",
        "Scendi controllando il movimento mantenendo il busto eretto",
        "Spingi sui talloni per risalire",
        "Mantieni la colonna neutra durante tutto il movimento"
      ]
    },
    "panca": {
      "name": "Panca",
      "it": "Panca piana con bilanciere",
      "gear": "Bilanciere, panca piana, dischi",
      "how": [
        "Sdraiati sulla panca con i piedi ben appoggiati",
        "Abbassa il bilanciere al petto in modo controllato",
        "Spingi verso l'alto mantenendo le scapole retratte",
        "Evita di rimbalzare il bilanciere sul petto"
      ]
    },
    "stacco": {
      "name": "Stacco",
      "it": "Stacco da terra",
      "gear": "Bilanciere, dischi",
      "how": [
        "Posizionati con i piedi sotto il bilanciere",
        "Afferra il bilanciere mantenendo la schiena dritta",
        "Spingi con le gambe e distendi le anche per sollevare il peso",
        "Mantieni il bilanciere vicino al corpo durante il sollevamento"
      ]
    }
  },
