  "esercizi": {
    "jumping_jack": {
      "nome": "Jumping jack",
      "nome_esteso": "Jumping jack (saltelli a stella)",
      "attrezzi": "corpo libero (oppure corda per saltare)",
      "istruzioni": [
        "Parti in piedi con le gambe unite e le braccia lungo i fianchi",
        "Salta divaricando le gambe e portando le braccia sopra la testa",
        "Torna alla posizione di partenza con un salto fluido",
        "Mantieni un ritmo costante e la schiena dritta"
      ],
      "fonti": [
        "d1:f1:r2"
      ]
    },
    "pushup": {
      "nome": "Push-up",
      "nome_esteso": "Piegamenti sulle braccia (push-up)",
      "attrezzi": "corpo libero",
      "istruzioni": [
        "Mani a terra leggermente più larghe delle spalle, corpo in linea retta",
        "Piega i gomiti abbassando il petto verso il pavimento",
        "Spingi per tornare alla posizione di partenza",
        "Mantieni addome e glutei contratti durante il movimento"
      ],
      "fonti": [
        "d1:f1:r3"
      ]
    },
    "squat_corpo_libero": {
      "nome": "Squat a corpo libero",
      "nome_esteso": "Squat a corpo libero",
      "attrezzi": "corpo libero",
      "istruzioni": [
        "Piedi larghezza spalle, punte leggermente ruotate verso l'esterno",
        "Piega ginocchia e anche come per sederti su una sedia",
        "Scendi mantenendo la schiena dritta e il peso sui talloni",
        "Risali spingendo con le gambe fino alla posizione di partenza"
      ],
      "fonti": [
        "d1:f1:r4"
      ]
    },
    "mountain_climber": {
      "nome": "Mountain climber",
      "nome_esteso": "Mountain climber (scalatore)",
      "attrezzi": "corpo libero",
      "istruzioni": [
        "Posizione di plank con le mani sotto le spalle",
        "Porta alternativamente un ginocchio verso il petto",
        "Mantieni il bacino stabile e l'addome contratto",
        "Alterna le gambe con un ritmo rapido e controllato"
      ],
      "fonti": [
        "d1:f1:r5"
      ]
    },
    "superman": {
      "nome": "Superman",
      "nome_esteso": "Superman (estensione lombare a terra)",
      "attrezzi": "corpo libero",
      "istruzioni": [
        "Sdraiati a pancia in giù con braccia e gambe distese",
        "Solleva contemporaneamente braccia, petto e gambe da terra",
        "Mantieni la posizione per un istante contraendo la schiena",
        "Torna a terra in modo controllato"
      ],
      "fonti": [
        "d1:f1:r6",
        "d1:f1:r7"
      ]
    },
    "burpee": {
      "nome": "Burpee",
      "nome_esteso": "Burpee (oppure affondi in salto)",
      "attrezzi": "corpo libero",
      "istruzioni": [
        "Da in piedi scendi in accovacciata e appoggia le mani a terra",
        "Spingi le gambe indietro fino alla posizione di plank",
        "Torna in accovacciata con un salto e balza in alto",
        "Ripeti in modo fluido e continuo"
      ],
      "fonti": [
        "d1:f1:r8"
      ]
    }
  },
